# Local settings for `bun run dev`. Copy to .env.
# Workers read wrangler.jsonc in development (and .dev.vars, if you create one), and
# wrangler.production.jsonc in production.

# development | production | test
NODE_ENV=development
# debug | info | warning | error
LOG_LEVEL=info

# Where Bun listens.
HOST=127.0.0.1
PORT=3000

# Public URL of the MCP endpoint, written canonically. Also the OAuth resource identifier.
# Defaults to http://127.0.0.1:$PORT/mcp outside production; required in production.
# MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp

# Hostnames accepted in Host and Origin headers: lowercase, no scheme, no port.
# Default: the public URL's hostname, plus localhost, 127.0.0.1 and [::1] outside production.
# Origins may also list a browser-extension scheme, e.g. moz-extension://*
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGIN_HOSTNAMES=mcp.example.com

# stateless: also serve 2025-era clients. reject: 2026-07-28 clients only.
# MCP_LEGACY_MODE=stateless
# Largest request body in bytes. Default: the SDK's 4 MiB.
# MCP_MAX_REQUEST_BYTES=4194304

# none | bearer | oauth. Required in production. This server is its own OAuth authorization
# server in front of Linear (docs/oauth.md): use oauth, with OAUTH_* naming this server.
AUTH_MODE=oauth
OAUTH_ISSUER_URL=http://127.0.0.1:3000
OAUTH_AUTHORIZATION_URL=http://127.0.0.1:3000/authorize
OAUTH_TOKEN_URL=http://127.0.0.1:3000/token
OAUTH_REGISTRATION_URL=http://127.0.0.1:3000/register
# Scopes every request needs: the Linear scopes the proxy asks for.
OAUTH_SCOPES=read write

# Your own settings, declared in src/settings.ts.
# The server's Linear OAuth application. In Linear, add the callback URL
# http://127.0.0.1:3000/oauth/callback.
PROVIDER_CLIENT_ID=
PROVIDER_CLIENT_SECRET=
# 32 random bytes, base64url: `openssl rand -base64 32 | tr -d '=' | tr '+/' '-_'`.
# Encrypts stored tokens. Required in production. Changing it signs every user out.
RS_TOKENS_ENC_KEY=
# Client redirect URIs the proxy accepts besides native loopback, comma-separated.
PROXY_REDIRECT_ALLOWLIST=alice://oauth/callback
# Where Bun keeps tokens. Authorization state goes to <file>.oauth-authority/.
# RS_TOKENS_FILE=.data/tokens.json
# true: the tools also give the model each structured result as JSON text.
# LINEAR_MCP_INCLUDE_JSON_IN_CONTENT=false
